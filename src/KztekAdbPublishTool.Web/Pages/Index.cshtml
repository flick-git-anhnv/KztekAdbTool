@page
@using System.Linq
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" />
}

<!-- Toast container -->
<div id="kz-toast-container"></div>

<!-- Title bar -->
<div class="d-flex align-items-center mb-2">
    <h5 class="mb-0 me-3 kz-section-title">
        <i class="bi bi-phone-fill me-1"></i>Dashboard thiết bị
    </h5>
    <span id="device-count-badge" class="badge text-white" style="background-color: var(--kz-navy);">
        @Model.Devices.Count thiết bị
    </span>
</div>

<!-- ════════════ TOOLBAR ════════════ -->
<div class="kz-toolbar mb-3">
    <!-- Hàng 1: Package + APK -->
    <div class="row g-2 align-items-center mb-2">
        <div class="col-auto">
            <label class="col-form-label col-form-label-sm fw-semibold" for="txt-package">Gói cần theo dõi:</label>
        </div>
        <div class="col-auto">
            <input type="text" id="txt-package" class="form-control form-control-sm" style="width:240px"
                   placeholder="com.company.app" value="@Model.PackageName" />
        </div>
        <div class="col-auto ms-3">
            <button class="btn btn-kz-secondary btn-sm" id="btn-browse-apk" type="button">
                <i class="bi bi-folder2-open me-1"></i>Chọn APK...
            </button>
            <input type="file" id="input-apk-file" accept=".apk" class="d-none" />
        </div>
        <div class="col">
            <input type="text" id="txt-apk-path" class="form-control form-control-sm"
                   placeholder="Chưa chọn file APK" value="@Model.ApkPath" readonly />
        </div>
    </div>

    <!-- Hàng 2: IP:port + Connect -->
    <div class="row g-2 align-items-center mb-2">
        <div class="col-auto">
            <label class="col-form-label col-form-label-sm fw-semibold" for="txt-connect">Thêm nhanh (IP:port):</label>
        </div>
        <div class="col-auto">
            <input type="text" id="txt-connect" class="form-control form-control-sm" style="width:190px"
                   placeholder="192.168.1.50:5555" />
        </div>
        <div class="col-auto">
            <button class="btn btn-kz-primary btn-sm" id="btn-connect" type="button">
                <i class="bi bi-plug-fill me-1"></i>Kết nối
            </button>
        </div>
    </div>

    <!-- Hàng 3: Network scan + Refresh + Auto-detect -->
    <div class="row g-2 align-items-center">
        <div class="col-auto">
            <button class="btn btn-kz-secondary btn-sm" id="btn-network-scan" type="button"
                    data-bs-toggle="modal" data-bs-target="#networkScanModal">
                <i class="bi bi-radar me-1"></i>Quét dải mạng...
            </button>
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-secondary btn-sm" id="btn-refresh" type="button">
                <i class="bi bi-arrow-clockwise me-1"></i>Quét lại
            </button>
        </div>
        <div class="col-auto ms-2">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="chk-auto-detect" checked>
                <label class="form-check-label small" for="chk-auto-detect">Tự động phát hiện thiết bị</label>
            </div>
        </div>
    </div>
</div>

<!-- ════════════ MAIN CONTENT: GRID + ACTION PANEL ════════════ -->
<div class="d-flex gap-3 mb-2">

    <!-- Grid column -->
    <div class="flex-grow-1 overflow-hidden">
        <!-- Filter bar -->
        <div class="kz-filter-bar d-flex flex-wrap gap-3 align-items-center mb-2">
            <div class="d-flex align-items-center gap-2">
                <label class="form-label mb-0 small fw-semibold" for="filter-ip">Lọc IP/Serial:</label>
                <input type="text" id="filter-ip" class="form-control form-control-sm" style="width:160px"
                       placeholder="192.168..." />
            </div>
            <div class="d-flex align-items-center gap-2">
                <label class="form-label mb-0 small fw-semibold" for="filter-version">Lọc Version:</label>
                <input type="text" id="filter-version" class="form-control form-control-sm" style="width:140px"
                       placeholder="1.0.0" />
            </div>
        </div>

        <!-- Device table -->
        <div class="table-responsive kz-grid-container">
            <table class="table table-bordered table-sm table-hover mb-0" id="device-table">
                <thead>
                    <tr>
                        <th style="width:46px;" class="text-center">Chọn</th>
                        <th>Serial</th>
                        <th>Model</th>
                        <th>Trạng thái</th>
                        <th>Kết nối</th>
                        <th>Version đã cài</th>
                        <th>Thời gian cài</th>
                        <th>Lần thấy cuối</th>
                        <th>Kết quả cài lần cuối</th>
                    </tr>
                </thead>
                <tbody id="device-tbody">
                    @foreach (var d in Model.Devices.OrderByDescending(x => x.Status == "Online").ThenBy(x => x.Serial))
                    {
                        var offlineCls = d.Status != "Online" ? "offline-row" : "";
                        <tr class="@offlineCls"
                            data-serial="@d.Serial"
                            data-version="@(d.InstalledVersion ?? "")">
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input device-checkbox" />
                            </td>
                            <td>@d.Serial</td>
                            <td>@d.Model</td>
                            <td>@d.Status</td>
                            <td>@d.ConnectionType</td>
                            <td>@(d.InstalledVersion ?? "-")</td>
                            <td>@(d.LastInstallTime?.ToString("dd/MM HH:mm:ss") ?? "-")</td>
                            <td>@d.LastSeen.ToString("dd/MM HH:mm:ss")</td>
                            <td>@(d.LastInstallStatus ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Action panel -->
    <div class="kz-action-panel">
        <div class="kz-section-title mb-2">Hành động</div>

        <button class="btn btn-kz-secondary btn-sm w-100 text-start" id="btn-select-all" type="button">
            <i class="bi bi-check2-all me-1"></i>Chọn tất cả
        </button>

        <button class="btn btn-kz-primary btn-sm w-100 text-start" id="btn-install-selected" type="button">
            <i class="bi bi-download me-1"></i>Cài đặt thiết bị đã chọn
        </button>

        <button class="btn btn-kz-primary btn-sm w-100 text-start" id="btn-install-all" type="button">
            <i class="bi bi-cloud-download me-1"></i>Cài đặt tất cả (Online)
        </button>

        <button class="btn btn-outline-danger btn-sm w-100 text-start" id="btn-remove-selected" type="button">
            <i class="bi bi-trash me-1"></i>Xóa thiết bị đã chọn
        </button>

        <hr class="my-2" />

        <div class="progress kz-progress-bar" style="height:14px;">
            <div id="install-progress" class="progress-bar kz-progress-fill"
                 role="progressbar" style="width:0%"
                 aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
        <div id="status-label" class="status-label mt-1">Sẵn sàng.</div>
    </div>
</div>

<!-- ════════════ LOG AREA ════════════ -->
<div class="mb-2">
    <div class="kz-section-title"><i class="bi bi-journal-text me-1"></i>Nhật ký hoạt động</div>
    <pre id="log"></pre>
</div>

<!-- ════════════ NETWORK SCAN MODAL (STEP-2.7) ════════════ -->
<div class="modal fade" id="networkScanModal" tabindex="-1"
     aria-labelledby="networkScanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header kz-modal-header">
                <h5 class="modal-title text-white" id="networkScanModalLabel">
                    <i class="bi bi-radar me-1"></i>Quét dải mạng LAN
                </h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <!-- Scan inputs -->
                <div class="row g-2 align-items-center mb-3">
                    <div class="col-auto">
                        <label class="col-form-label col-form-label-sm fw-semibold" for="scan-range">Dải IP:</label>
                    </div>
                    <div class="col-auto">
                        <input type="text" id="scan-range" class="form-control form-control-sm" style="width:240px"
                               placeholder="192.168.1.1-254" />
                    </div>
                    <div class="col-auto ms-2">
                        <label class="col-form-label col-form-label-sm fw-semibold" for="scan-port">Cổng:</label>
                    </div>
                    <div class="col-auto">
                        <input type="text" id="scan-port" class="form-control form-control-sm" style="width:75px"
                               value="5555" />
                    </div>
                    <div class="col-auto ms-2">
                        <button class="btn btn-kz-primary btn-sm" id="btn-scan-start" type="button">
                            <i class="bi bi-play-fill me-1"></i>Quét
                        </button>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-outline-secondary btn-sm" id="btn-scan-stop" type="button" disabled>
                            <i class="bi bi-stop-fill me-1"></i>Dừng
                        </button>
                    </div>
                </div>

                <!-- Scan progress -->
                <div class="progress mb-1" style="height:10px;">
                    <div id="scan-progress-bar" class="progress-bar kz-progress-fill"
                         style="width:0%" role="progressbar"></div>
                </div>
                <div id="scan-status" class="small text-muted mb-2">Nhập dải IP rồi bấm Quét.</div>

                <!-- Scan results table -->
                <div style="max-height:280px; overflow-y:auto;">
                    <table class="table table-sm table-bordered table-hover mb-0" id="scan-result-table">
                        <thead>
                            <tr>
                                <th style="width:46px; background-color:var(--kz-navy); color:#fff;" class="text-center">Thêm</th>
                                <th style="background-color:var(--kz-navy); color:#fff;">Địa chỉ thiết bị phản hồi</th>
                            </tr>
                        </thead>
                        <tbody id="scan-result-tbody"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-kz-primary btn-sm" id="btn-scan-add">
                    <i class="bi bi-plus-circle me-1"></i>Thêm vào danh sách
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Đóng
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js"></script>
    <script src="~/js/scan-modal.js"></script>
}
