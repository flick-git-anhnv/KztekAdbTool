<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — KZTEK ADB Publish Tool</title>

    <!-- Bootstrap 5 CDN -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --kz-navy: #251C53;
            --kz-navy-light: #4A3F8C;
            --kz-navy-pale: #B8B3D6;
            --kz-orange: #F05922;
            --kz-orange-light: #FFAA80;
            --kz-gray: #CBCBCB;
        }

        body {
            background-color: #f8f9fa;
        }

        .navbar-kztek {
            background-color: var(--kz-navy);
        }

        .navbar-kztek .navbar-brand {
            color: #ffffff;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .navbar-kztek .navbar-brand span.accent {
            color: var(--kz-orange);
        }

        .navbar-kztek .nav-link {
            color: var(--kz-navy-pale);
        }

        .navbar-kztek .nav-link:hover,
        .navbar-kztek .nav-link.active {
            color: #ffffff;
        }

        .btn-kz-primary {
            background-color: var(--kz-orange);
            border-color: var(--kz-orange);
            color: #ffffff;
        }

        .btn-kz-primary:hover {
            background-color: var(--kz-orange-light);
            border-color: var(--kz-orange-light);
            color: var(--kz-navy);
        }

        .btn-kz-secondary {
            background-color: var(--kz-navy);
            border-color: var(--kz-navy);
            color: #ffffff;
        }

        .btn-kz-secondary:hover {
            background-color: var(--kz-navy-light);
            border-color: var(--kz-navy-light);
            color: #ffffff;
        }

        footer {
            background-color: var(--kz-navy);
            color: var(--kz-navy-pale);
            font-size: 0.85rem;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-kztek shadow-sm">
        <div class="container-fluid px-3">
            <a class="navbar-brand" asp-page="/Index">
                <i class="bi bi-phone-fill me-1"></i>
                KZTEK <span class="accent">ADB</span> Publish Tool
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarMain" aria-controls="navbarMain"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Index">
                            <i class="bi bi-grid-fill me-1"></i>Dashboard
                        </a>
                    </li>
                </ul>
                <!-- SignalR connection status indicator -->
                <span id="signalr-status" class="badge ms-3 bg-secondary">
                    <i class="bi bi-wifi-off me-1"></i>Đang kết nối...
                </span>
            </div>
        </div>
    </nav>

    <main class="container-fluid px-3 py-3">
        @RenderBody()
    </main>

    <footer class="py-2 mt-4">
        <div class="container-fluid px-3 text-center">
            KZTEK ADB Publish Tool &copy; @DateTime.Now.Year — KZTEK (kztek.net)
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmRGMhGffd0nJBFHJPfKtNkiQe2"
            crossorigin="anonymous"></script>

    <!-- SignalR client (Microsoft CDN) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
            integrity="sha512-vFGBDolbCXGSBi2mBiGbF+bY2zWgI6G8XgJhgBpCOB0VDhvjIGGnQ0JeGlFXqLBZm1mRcFvGjxdvKzM6JWtw=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <!-- KZTEK SignalR client -->
    <script src="~/js/signalr-client.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
